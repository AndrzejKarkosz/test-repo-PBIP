table 'Dynamic Measures'
	lineageTag: 0b384f0d-ab08-4199-9d02-225af96cc1eb

	calculationGroup

		calculationItem Impressions = CALCULATE ( SELECTEDMEASURE () )

		calculationItem Clicks = CALCULATE ( SELECTEDMEASURE () )

		calculationItem Investment = CALCULATE ( SELECTEDMEASURE () )

		calculationItem CTR = CALCULATE ( SELECTEDMEASURE () )

		calculationItem CPV = CALCULATE ( SELECTEDMEASURE () )

		calculationItem CPM = CALCULATE ( SELECTEDMEASURE () )

	measure DynamicMeasure = ```
			
			Var SelectedMeasure = 
			SELECTEDVALUE('Dynamic Measures'[Name], "Impressions")
			Var DynamicMeasure=
			SWITCH(
			True(), 
			SelectedMeasure = "Impressions", [Total Impressions],
			SelectedMeasure = "Clicks", [Total Clicks],
			SelectedMeasure = "Investment", [Total Investment],
			SelectedMeasure = "CTR", [CTR],
			SelectedMeasure = "CPV", [CPV],
			SelectedMeasure = "CPM", [CPM],
			
			Blank()
			)
			
			return DynamicMeasure
			```
		formatString: #,0
		lineageTag: 876704fd-ff71-4b46-845d-ddeec3689220

